% 参考文献データベース
%   Google Scholar の「引用」→「BibTeX」や CiNii，各出版社のページからコピーして貼り付けられる．
%   日本語文献は yomi フィールドに読みを入れると jplain で著者名順に正しく並ぶ．

@book{sample-book,
  author    = {著者 太郎},
  yomi      = {ちょしゃ たろう},
  title     = {書籍タイトル},
  publisher = {出版社},
  year      = {2020}
}

@article{sample-article,
  author  = {Author, Alice and Author, Bob},
  title   = {Title of the Article},
  journal = {Journal Name},
  volume  = {1},
  number  = {2},
  pages   = {3--4},
  year    = {2020}
}

@inproceedings{sample-proceedings,
  author    = {Author, Alice},
  title     = {Title of the Paper},
  booktitle = {Proceedings of the Conference Name},
  pages     = {1--10},
  year      = {2020}
}

@misc{sample-web,
  author       = {組織名},
  title        = {ページタイトル},
  howpublished = {\url{https://example.com/}},
  note         = {(参照 2020-01-01)},
  year         = {2020}
}
